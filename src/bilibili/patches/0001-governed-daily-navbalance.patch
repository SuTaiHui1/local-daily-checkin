+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public async Task SameVideo_ThreeActualApplicationBranches_ProduceEquivalentShareRequests(bool followedUp)
+    {
+        var shares = new List<WireRequest>();
+        foreach (string mode in new[] { "DirectProbe", "NormalProbe", "Daily" })
+        {
+            using var fixture = new Fixture(mode, followedUp: followedUp);
+            await fixture.Run();
+            Assert.True(fixture.Wire.Requests.Any(r => r.Path == Share), mode + ": " +
+                string.Join(" | ", fixture.Log.Entries.Select(e => e.Message)));
+            var share = Assert.Single(fixture.Wire.Requests.Where(r => r.Path == Share));
+            shares.Add(share);
+            Assert.Equal("POST", share.Method);
+            Assert.Equal("123456", share.Form["aid"]);
+            Assert.Equal(new[] { "aid", "csrf", "eab_x", "ga", "ramval", "source" }, share.Form.Keys.Order().ToArray());
+            Assert.InRange(int.Parse(share.Form["ramval"]), 3, 19);
+            Assert.Equal(mode == "DirectProbe" ? 0 : mode == "NormalProbe" ? 1 : 2,
+                fixture.Wire.Requests.Count(r => r.Path == Heartbeat));
+            Assert.Equal(mode == "DirectProbe" ? new[] { "Status" } : new[] { "Login", "Status" }, fixture.AccountCalls);
+            Assert.Equal(mode == "Daily" ? 1 : 0, fixture.VipCalls);
+            Assert.Contains(fixture.Log.Entries, e => e.Message.Contains(mode == "Daily" ?
+                "FlowCompleted DailyTask" : "FlowCompleted ShareProbe"));
+        }
+        foreach (var share in shares.Skip(1))
+        {
+            Assert.Equal(shares[0].Headers.OrderBy(k => k.Key), share.Headers.OrderBy(k => k.Key));
+            Assert.Equal(shares[0].ContentType, share.ContentType);
+            Assert.Equal(shares[0].Query, share.Query);
+            Assert.Equal(shares[0].Version, share.Version);
+            Assert.Equal(shares[0].VersionPolicy, share.VersionPolicy);
+            Assert.Equal(shares[0].Form.Where(p => p.Key != "ramval").OrderBy(p => p.Key),
+                share.Form.Where(p => p.Key != "ramval").OrderBy(p => p.Key));
+        }
+    }
