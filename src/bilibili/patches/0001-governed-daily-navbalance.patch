+namespace Ray.BiliBiliTool.Console.Diagnostics;
+
+public static class GovernedDailyGate
+{
+    public static string Decide(string[] args, bool windows, bool production, bool elevated)
+    {
+        if (!windows || !production) return "HostOrProductionEnvironmentRequired";
+        if (elevated) return "OrdinaryUserRequired";
+        return args.Length == 1 && args[0] is "--runTasks=Daily" or "--runTasks=Login" ? "Ready" : "ModeNotAllowed";
+    }
+
+    public static Dictionary<string, string?> ConfigurationOverrides(bool daily) => new()
+    {
+        ["RunTasks"] = daily ? "Daily" : "Login",
+        ["Repair:GovernedDaily"] = daily.ToString(),
+        ["Repair:BrowserShareRequired"] = daily.ToString(),
+        ["Repair:CoinRemainderOnly"] = "false",
+        ["Repair:FixedVideoDiagnostic"] = "false",
+        ["Repair:ShareProbeOnly"] = "false",
+        ["Repair:Scope"] = daily ? "GovernedDaily" : "Login",
+        ["DailyTaskConfig:IsEnable"] = "true",
+        ["DailyTaskConfig:IsWatchVideo"] = "true",
+        ["DailyTaskConfig:IsShareVideo"] = "true",
+        ["DailyTaskConfig:IsDonateCoinForArticle"] = "false",
+        ["DailyTaskConfig:SelectLike"] = "false",
+        ["DailyTaskConfig:NumberOfCoins"] = "5",
+        ["DailyTaskConfig:NumberOfProtectedCoins"] = "0",
+        ["DailyTaskConfig:CoinDonationStopLevel"] = "6",
+        ["DailyTaskConfig:SaveCoinsWhenLv6"] = "true",
+        ["CookieCheck:AutoCheckEnabled"] = "false",
+    };
+}
