+            if (builder.Name!.Contains(nameof(IApiApi), StringComparison.Ordinal))
+                Assert.False(Assert.IsType<HttpClientHandler>(builder.PrimaryHandler).UseCookies);
+            builder.PrimaryHandler = wire;
+        };
+    }
+    private sealed record Request(string Method, string Path, string Query,
+        Dictionary<string, string> Headers, Dictionary<string, string> Form);
+    private sealed class MemoryWire(string? detailCase, string? failedStage) : HttpMessageHandler
+    {
+        public List<Request> Requests { get; } = [];
+        private int _heartbeats;
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken token)
+        {
+            string path = request.RequestUri!.AbsolutePath;
+            var body = HttpUtility.ParseQueryString(request.Content is null ? "" : await request.Content.ReadAsStringAsync(token));
+            Requests.Add(new Request(request.Method.Method, path, request.RequestUri.Query,
+                request.Headers.ToDictionary(p => p.Key, p => string.Join(";", p.Value), StringComparer.OrdinalIgnoreCase),
+                body.AllKeys.ToDictionary(k => k!, k => body[k!]!)));
+            string response;
+            int code = 0;
+            if (path == View)
+            {
+                if (detailCase == "transport") throw new HttpRequestException("PRIVATE_SENTINEL");
+                if (detailCase == "business-exception") throw new Ray.BiliBiliTool.Domain.Exceptions.BiliBusinessException("PRIVATE_SENTINEL");
+                response = DetailResponse(detailCase);
+            }
+            else if (path is Heartbeat or Share)
+            {
+                string stage = path == Share ? "share" : ++_heartbeats == 1 ? "start" : "progress";
+                code = stage == failedStage ? -403 : 0;
+                response = JsonSerializer.Serialize(new { code, message = "PRIVATE_SENTINEL" });
+            }
+            else if (path == "/x/relation/followings") response = "{\"code\":0,\"data\":{\"total\":0,\"list\":[]}}";
+            else if (path == "/x/web-interface/ranking/v2") response = "{\"code\":0,\"data\":{\"list\":[{\"aid\":654321,\"bvid\":\"BV_SYNTHETIC\",\"cid\":789,\"duration\":60,\"title\":\"Synthetic\"}]}}";
+            else throw new InvalidOperationException("Unexpected endpoint blocked by offline fixture");
+            var result = new HttpResponseMessage(HttpStatusCode.OK)
+            { RequestMessage = request, Content = new StringContent(response, Encoding.UTF8, "application/json") };
+            result.Headers.Add("Bili-Status-Code", code.ToString());
+            return result;
+        }
+        private static string DetailResponse(string? variant)
+        {
+            if (variant == "malformed") return "PRIVATE_SENTINEL";
+            if (variant == "null-data") return "{\"code\":0,\"data\":null}";
+            if (variant == "business-error") return "{\"code\":-403,\"message\":\"PRIVATE_SENTINEL\"}";
+            var data = JsonSerializer.SerializeToNode(new
+            {
+                aid = Target, bvid = "BV1xx411c7mD", cid = 456, videos = 2,
+                title = "Synthetic fixed video", state = 0, duration = 90,
+                pages = new[] { new { page = 1, cid = 456, duration = 7 }, new { page = 2, cid = 457, duration = 83 } },
+            })!.AsObject();
+            switch (variant)
+            {
+                case "wrong-aid": data["aid"] = Target + 1; break;
+                case "missing-cid": data.Remove("cid"); break;
+                case "missing-bvid": data.Remove("bvid"); break;
+                case "bad-bvid": data["bvid"] = "not-a-video"; break;
+                case "missing-title": data.Remove("title"); break;
+                case "missing-state": data.Remove("state"); break;
+                case "unavailable": data["state"] = -4; break;
+                case "missing-pages": data.Remove("pages"); break;
+                case "wrong-page": data["pages"]![0]!["page"] = 2; break;
+                case "wrong-page-cid": data["pages"]![0]!["cid"] = 999; break;
+                case "missing-page-duration": data["pages"]![0]!.AsObject().Remove("duration"); break;
+                case "zero-page-duration": data["pages"]![0]!["duration"] = 0; break;
+                case "overflow-page-duration": data["pages"]![0]!["duration"] = long.MaxValue; break;
+                case "wrong-page-count": data["videos"] = 3; break;
+                case "short-total": data["duration"] = 1; break;
+            }
+            return new JsonObject { ["code"] = 0, ["data"] = data }.ToJsonString();
+        }
+    }
+}
