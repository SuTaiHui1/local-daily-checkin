diff --git a/src/Ray.BiliBiliTool.Agent/HttpClientDelegatingHandlers/ShareContextDiagnosticDelegatingHandler.cs b/src/Ray.BiliBiliTool.Agent/HttpClientDelegatingHandlers/ShareContextDiagnosticDelegatingHandler.cs
new file mode 100644
index 0000000..c1f4adf
--- /dev/null
+++ b/src/Ray.BiliBiliTool.Agent/HttpClientDelegatingHandlers/ShareContextDiagnosticDelegatingHandler.cs
@@ -0,0 +1,152 @@
+using System.Globalization;
+using System.Text.Json;
+using System.Web;
+using Microsoft.Extensions.Logging;
+
+namespace Ray.BiliBiliTool.Agent.HttpClientDelegatingHandlers;
+
+// Observe only fixed-shape metadata; never log authentication values or raw messages.
+public sealed class ShareContextDiagnosticDelegatingHandler(
+    ILogger<ShareContextDiagnosticDelegatingHandler> logger) : DelegatingHandler
+{
+    private long _sequence;
+    private Dictionary<string, string>? _firstAuthContext;
+    private readonly object _contextLock = new();
+
+    protected override async Task<HttpResponseMessage> SendAsync(
+        HttpRequestMessage request, CancellationToken cancellationToken)
+    {
+        string? stage = request.RequestUri?.AbsolutePath switch
+        {
+            "/x/click-interface/web/heartbeat" => "Heartbeat",
+            "/x/web-interface/share/add" => "Share",
+            _ => null,
+        };
+        if (stage is null)
+            return await base.SendAsync(request, cancellationToken);
+
+        long sequence = Interlocked.Increment(ref _sequence);
+        try
+        {
+            string body = request.Content is null ? "" :
+                await request.Content.ReadAsStringAsync(cancellationToken);
+            var form = HttpUtility.ParseQueryString(body);
+            var auth = new Dictionary<string, string>(StringComparer.Ordinal);
+            bool duplicateKnown = false;
+            if (request.Headers.TryGetValues("Cookie", out var values))
+                foreach (string item in string.Join(";", values).Split(';'))
+                {
+                    int separator = item.IndexOf('=');
+                    if (separator <= 0) continue;
+                    string key = item[..separator].Trim();
+                    if (key is not ("SESSDATA" or "bili_jct" or "buvid3" or "_uuid")) continue;
+                    if (!auth.TryAdd(key, item[(separator + 1)..].Trim())) duplicateKnown = true;
+                }
+            bool Present(string key) => auth.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value);
+            long? aid = Number(form["aid"]);
+            string? expectedReferer = aid.HasValue ? $"https://www.bilibili.com/video/av{aid.Value}/" : null;
+            bool? refererMatches = expectedReferer is null ? null :
+                string.Equals(request.Headers.Referrer?.AbsoluteUri, expectedReferer, StringComparison.Ordinal);
+            bool? authMatches = Present("bili_jct") && form["csrf"] is { } csrf ?
+                string.Equals(auth["bili_jct"], csrf, StringComparison.Ordinal) : null;
+            bool contextStable;
+            lock (_contextLock)
+            {
+                _firstAuthContext ??= new Dictionary<string, string>(auth, StringComparer.Ordinal);
+                contextStable = _firstAuthContext.Count == auth.Count &&
+                    _firstAuthContext.All(pair => auth.TryGetValue(pair.Key, out var value) && value == pair.Value);
+            }
+            logger.LogInformation(
+                "SHARE_CONTEXT Prepared Seq={seq} Stage={stage} Video={video} Action={action} Start={start} Progress={progress} AuthFieldsPresent={authPresent} FormAuthMatches={authMatches} DevicePresent={device} ProfileMarkerPresent={profile} DuplicateKnown={duplicate} RefererMatches={referer} Cid={cid} AuthContextStable={stable} Eab={eab} Ram={ram} SourceKind={source} Ga={ga} AuthContextScope=FourKnownFields AuthContextBaseline=HandlerLifetime",
+                sequence, stage, aid, Number(form["play_type"]), Number(form["start_ts"]),
+                Number(form["played_time"]), Present("SESSDATA") && Present("bili_jct"),
+                authMatches, Present("buvid3"), Present("_uuid"), duplicateKnown, refererMatches,
+                Number(form["cid"]), contextStable, Number(form["eab_x"]), Number(form["ramval"]),
+                form["source"] is null ? "Missing" : form["source"] == "web_normal" ? "WebNormal" : "Other",
+                Number(form["ga"]));
+        }
+        catch (OperationCanceledException) { throw; }
+        catch (Exception)
+        {
+            // Observation must not replace the original transport/error behavior.
+            logger.LogInformation("SHARE_CONTEXT Prepared Seq={seq} Stage={stage} Metadata=Unavailable", sequence, stage);
+        }
+
+        HttpResponseMessage response = await base.SendAsync(request, cancellationToken);
+        long? serverCode = null;
+        if (response.Headers.TryGetValues("Bili-Status-Code", out var serverValues))
+        {
+            var codes = serverValues.ToArray();
+            if (codes.Length == 1) serverCode = Number(codes[0]);
+        }
+        bool verificationHint = response.Headers.Contains("X-Bili-Gaia-Vvoucher") ||
+            response.Headers.Contains("X-Bili-Gaia-Vtoken");
+        string failureReason = await ObserveFailureReason(response, stage, serverCode, cancellationToken);
+        logger.LogInformation(
+            "SHARE_CONTEXT Reply Seq={seq} Stage={stage} Http={http} ServerCode={serverCode} VerifyHeaderPresent={verify} FailureReason={reason}",
+            sequence, stage, (int)response.StatusCode, serverCode, verificationHint, failureReason);
+        return response;
+    }
+
+    private const long MaximumReasonBytes = 16 * 1024;
+
+    private static async Task<string> ObserveFailureReason(
+        HttpResponseMessage response, string stage, long? serverCode, CancellationToken cancellationToken)
+    {
+        if (stage != "Share" || serverCode is null or 0)
+            return "NotObserved";
+        if (response.Content is null)
+            return "NotProvided";
+        // Do not drain an unbounded or unexpectedly large response for diagnostics.
+        if (response.Content.Headers.ContentLength is not { } length)
+            return "BodyLengthUnknown";
+        if (length > MaximumReasonBytes)
+            return "BodyTooLarge";
+        string? mediaType = response.Content.Headers.ContentType?.MediaType;
+        if (mediaType is not null && !mediaType.Equals("application/json", StringComparison.OrdinalIgnoreCase))
+            return "BodyNotJson";
+        using var deadline = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
+        deadline.CancelAfter(TimeSpan.FromSeconds(1));
+        try
+        {
+            // HttpContent buffers this body so the existing Refit reader sees the same bytes.
+            await response.Content.LoadIntoBufferAsync(MaximumReasonBytes, deadline.Token);
+            string body = await response.Content.ReadAsStringAsync(deadline.Token);
+            using var document = JsonDocument.Parse(body);
+            var root = document.RootElement;
+            if (root.ValueKind != JsonValueKind.Object ||
+                !root.TryGetProperty("code", out var code) || !code.TryGetInt64(out long bodyCode))
+                return "BodyUnconfirmed";
+            if (bodyCode != serverCode)
+                return "ReplyCodeMismatch";
+            if (!root.TryGetProperty("message", out var message) || message.ValueKind != JsonValueKind.String)
+                return "NotProvided";
+            return ClassifyFailureMessage(message.GetString());
+        }
+        catch (OperationCanceledException) when (!cancellationToken.IsCancellationRequested)
+        {
+            return "BodyReadTimedOut";
+        }
+        catch (OperationCanceledException) { throw; }
+        catch (Exception)
+        {
+            return "BodyUnconfirmed";
+        }
+    }
+
+    private static string ClassifyFailureMessage(string? message)
+    {
+        if (string.IsNullOrWhiteSpace(message)) return "NotProvided";
+        foreach (var (text, category) in new[] {
+            ("账号异常", "AccountAbnormal"), ("未登录", "NotLoggedIn"),
+            ("csrf", "CsrfRejected"), ("过于频繁", "TooFrequent"),
+            ("请求频繁", "TooFrequent"), ("验证码", "VerificationRequired"),
+            ("请求被拦截", "RequestRejected"), ("权限不足", "PermissionDenied"),
+            ("视频不存在", "VideoUnavailable"), ("视频不可用", "VideoUnavailable") })
+            if (message.Contains(text, StringComparison.OrdinalIgnoreCase)) return category;
+        return "OtherReasonWithheld";
+    }
+
+    private static long? Number(string? value) =>
+        long.TryParse(value, NumberStyles.AllowLeadingSign, CultureInfo.InvariantCulture, out long parsed) ? parsed : null;
+}
