+        output.WriteLine("Handler entries=" + fixture.Route.Attempts + "; actual requests=" + all.Length);
+        Assert.Empty(all.Where(request => request.Path == "/redirect-followed"));
+        Assert.Empty(sink.Requests);
+        Assert.IsAssignableFrom<BiliBusinessException>(error);
