+        Assert.Contains("BusinessCode=" + code, error.Message);
+        Assert.Equal(0, f.CandidateCalls);
+        Assert.Equal(0, f.AddCalls);
+        Assert.Equal(1, f.CountCalls);
+        Assert.DoesNotContain("PRIVATE_SENTINEL", error.ToString());
+    }
+
+    private sealed class Fixture : IDisposable
+    {
+        private readonly string _stage, _failure;
+        private readonly BiliApiResponse<GetFollowingsResponse>? _followingResponse;
+        public TestLogCollector Log { get; } = new();
+        private readonly ILoggerFactory _logs;
+        public int CandidateCalls, CountCalls, AddCalls, FollowingCalls;
+        public List<AddCoinRequest> AddRequests { get; } = [];
+        public BiliCookie Cookie { get; } = new(new Dictionary<string, string> { ["DedeUserID"] = "123", ["SESSDATA"] = "SIMULATED_SESSION", ["bili_jct"] = "SIMULATED_CSRF", ["buvid3"] = "SIMULATED_DEVICE" });
+        public DonateCoinDomainService Service { get; }
+
+        public Fixture(string stage, string failure, BiliApiResponse<GetFollowingsResponse>? followingResponse = null)
+        {
+            _stage = stage; _failure = failure;
+            _followingResponse = followingResponse;
+            _logs = LoggerFactory.Create(b => b.ClearProviders().AddProvider(Log));
+            var options = new Monitor(new DailyTaskOptions { NumberOfCoins = 5, NumberOfProtectedCoins = 0,
+                SelectLike = false, SupportUpIds = stage.StartsWith("Up") ? "321" : null });
+            var api = Stub<IApiApi>(Call);
+            var video = new VideoDomainService(_logs.CreateLogger<VideoDomainService>(), options, api);
+            var coin = Stub<ICoinDomainService>((m, _) => m.Name switch {
+                "GetDonatedCoins" => Task.FromResult(0), "GetCoinBalance" => Task.FromResult(20m),
+                _ => throw new InvalidOperationException("Unexpected synthetic coin operation") });
+            Service = new DonateCoinDomainService(_logs.CreateLogger<DonateCoinDomainService>(), options,
+                Stub<IAccountApi>((_, _) => throw new InvalidOperationException("No account API expected")), coin, video, api);
+        }
+
+        private object Call(MethodInfo method, object?[]? args)
+        {
+            switch (method.Name)
+            {
+                case "GetFollowingsByTag":
+                    return Task.FromResult(new BiliApiResponse<List<UpInfo>> { Code = 0, Data = [] });
+                case "GetFollowings":
+                    FollowingCalls++;
+                    return Task.FromResult(_followingResponse ?? new BiliApiResponse<GetFollowingsResponse> { Code = 0, Data = new() { Total = 0, List = [] } });
+                case "GetRegionRankingVideosV2":
+                    CandidateCalls++;
+                    if (CandidateCalls == 4) return RankingFailure();
+                    return Task.FromResult(new BiliApiResponse<Ranking> { Code = 0, Data = new() { List = [new() { Aid = 100 + CandidateCalls, Bvid = "BV1234567890", Title = "fixture" }] } });
+                case "SearchVideosByUpId":
+                    var request = (SearchVideosByUpIdDto)args![0]!;
+                    if (request.ps != 1)
+                    {
+                        CountCalls++;
+                        if (_stage == "UpVideoCount") return UpFailure();
+                        return Task.FromResult(new BiliApiResponse<SearchUpVideosResponse> { Code = 0, Data = new() { Page = new() { Count = 10 } } });
+                    }
+                    CandidateCalls++;
+                    if (CandidateCalls == 4) return UpFailure();
+                    return Task.FromResult(new BiliApiResponse<SearchUpVideosResponse> { Code = 0, Data = new() { Page = new(), List = new() { Vlist = [new() { Aid = 100 + CandidateCalls, Bvid = "BV1234567890", Title = "fixture", Length = "00:15" }] } } });
+                case "GetDonatedCoinsForVideo":
+                    return Task.FromResult(new BiliApiResponse<DonatedCoinsForVideo> { Code = 0, Data = new() { Multiply = 0 } });
+                case "GetVideoDetail":
+                    return Task.FromResult(new BiliApiResponse<VideoDetail> { Code = 0, Data = new() { Copyright = 1, Bvid = "BV1234567890", Title = "fixture" } });
+                case "AddCoinForVideo":
+                    AddCalls++; AddRequests.Add((AddCoinRequest)args![0]!);
+                    return Task.FromResult(new BiliApiResponse { Code = 0 });
+                default: throw new InvalidOperationException("Unexpected synthetic API operation: " + method.Name);
+            }
+        }
+        private void ThrowFailure()
+        {
+            if (_failure == "http") throw new HttpRequestException("PRIVATE_SENTINEL", null, HttpStatusCode.PreconditionFailed);
+            if (_failure == "transport") throw new HttpRequestException("PRIVATE_SENTINEL");
+            if (_failure == "json") throw new JsonException("PRIVATE_SENTINEL");
+        }
+        private object RankingFailure()
+        {
+            ThrowFailure();
+            BiliApiResponse<Ranking>? value = _failure switch {
+                "null" => null,
+                "missing-code" => new() { Data = new() },
+                "missing-data" => new() { Code = 0 },
+                "empty" => new() { Code = 0, Data = new() },
+                _ => new() { Code = -403, Message = "PRIVATE_SENTINEL" } };
+            return Task.FromResult(value);
+        }
+        private object UpFailure()
+        {
+            ThrowFailure();
+            if (_failure is "null-row" or "zero-aid" or "blank-bvid" or "blank-title")
+                return Task.FromResult(new BiliApiResponse<SearchUpVideosResponse> { Code = 0, Data = new() {
+                    Page = new(), List = new() { Vlist = [_failure == "null-row" ? null! : new() {
+                        Aid = _failure == "zero-aid" ? 0 : 104,
+                        Bvid = _failure == "blank-bvid" ? " " : "BV1234567890",
+                        Title = _failure == "blank-title" ? " " : "fixture", Length = "00:15" }] } } });
+            return Task.FromResult(new BiliApiResponse<SearchUpVideosResponse> {
+                Code = _failure == "missing-code" ? int.MinValue : _failure is "missing-data" or "empty" ? 0 : -403,
+                Message = "PRIVATE_SENTINEL", Data = _failure == "empty" ? new() { Page = new(), List = new() } : null });
+        }
+        public void Dispose() => _logs.Dispose();
+    }
+    private sealed class Monitor(DailyTaskOptions options) : IOptionsMonitor<DailyTaskOptions>
+    {
+        public DailyTaskOptions CurrentValue => options;
+        public DailyTaskOptions Get(string? name) => options;
+        public IDisposable? OnChange(Action<DailyTaskOptions, string?> listener) => null;
+    }
+    public class MethodStub : DispatchProxy
+    {
+        public Func<MethodInfo, object?[]?, object?> Handler = null!;
+        protected override object? Invoke(MethodInfo? targetMethod, object?[]? args) => Handler(targetMethod!, args);
+    }
+    private static T Stub<T>(Func<MethodInfo, object?[]?, object?> handler) where T : class
+    {
+        var proxy = DispatchProxy.Create<T, MethodStub>();
+        ((MethodStub)(object)proxy).Handler = handler;
+        return proxy;
+    }
+}
