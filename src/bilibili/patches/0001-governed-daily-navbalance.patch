+        });
+        var open = HttpUtility.ParseQueryString(mutations[0].Body);
+        Assert.Equal("1", open["play_type"]);
+        Assert.Equal("0", open["played_time"]);
+        Assert.Single(mutations, request => request.Path == Share);
+    }
+
+    [Fact]
+    public async Task FirstWatch_ReusesPlaybackStartAndReportsStartThenProgress()
+    {
+        await using var fixture = new Fixture(delayAfterOpen: true);
+        await fixture.Run(watched: false);
+        var heartbeats = fixture.Server.Requests.Where(x => x.Path == Heartbeat).ToArray();
+        Assert.Equal(2, heartbeats.Length);
+        var start = HttpUtility.ParseQueryString(heartbeats[0].Body);
+        var progress = HttpUtility.ParseQueryString(heartbeats[1].Body);
+        Assert.Equal(start["start_ts"], progress["start_ts"]);
+        foreach (var key in new[] { "aid", "bvid", "cid", "mid", "csrf" })
