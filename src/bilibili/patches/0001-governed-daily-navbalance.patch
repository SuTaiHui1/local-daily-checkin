+    [InlineData("UpVideoPage", "blank-bvid", "InvalidData", "Unknown", "0")]
+    [InlineData("UpVideoPage", "blank-title", "InvalidData", "Unknown", "0")]
+    public async Task FourthCandidateFailure_PreservesThreeSuccesses_StopsWithoutRetryOrFallback(
+        string stage, string failure, string kind, string http, string code)
+    {
+        using var f = new Fixture(stage, failure);
