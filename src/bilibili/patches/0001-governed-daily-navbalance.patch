+using System.Net;
+using System.Reflection;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.Logging;
+using Ray.BiliBiliTool.Agent.BiliBiliAgent.Interfaces;
+using Ray.BiliBiliTool.Agent.Extensions;
+using Refit;
+
+namespace Ray.BiliBiliTool.CharacterizationTests;
+
+public sealed class NavBalanceSerializationTests
+{
+    [Theory]
+    [InlineData("277.1", "277.1")]
+    [InlineData("0.9", "0.9")]
+    [InlineData("null", null)]
+    public async Task Production_Refit_settings_preserve_nav_decimal_or_null(string input, string? expected)
+    {
+        using var services = new ServiceCollection().AddLogging().BuildServiceProvider();
+        var method = typeof(ServiceCollectionExtension).GetMethod("CreateBiliBiliRefitSettings", BindingFlags.Static | BindingFlags.NonPublic)!;
+        var settings = (RefitSettings)method.Invoke(null, [services])!;
+        var handler = new FixtureHandler("{\"code\":0,\"data\":{\"isLogin\":true,\"money\":" + input + ",\"level_info\":{\"current_level\":5},\"wbi_img\":{\"img_url\":\"synthetic\",\"sub_url\":\"synthetic\"}}}");
+        using var client = new HttpClient(handler) { BaseAddress = new Uri("https://offline.invalid") };
+        var response = await RestService.For<INavApi>(client, settings).GetNavAsync("SYNTHETIC");
+        Assert.Equal(0, response.Code);
+        Assert.Equal(expected is null ? (decimal?)null : decimal.Parse(expected, System.Globalization.CultureInfo.InvariantCulture), response.Data!.Money);
+        Assert.Equal(1, handler.Calls);
+    }
+
+    private sealed class FixtureHandler(string json) : HttpMessageHandler
+    {
+        public int Calls;
+        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
+        {
+            Calls++;
+            Assert.Equal("/x/web-interface/nav", request.RequestUri!.AbsolutePath);
+            return Task.FromResult(new HttpResponseMessage(HttpStatusCode.OK) { Content = new StringContent(json, System.Text.Encoding.UTF8, "application/json") });
+        }
+    }
+}
