+                ["Repair:ShareProbeOnly"] = (mode != "Daily").ToString(),
+                ["Repair:ShareProbeNormalPath"] = (mode == "NormalProbe").ToString(),
+                ["Repair:ShareProbeAid"] = "123456",
+            };
+            var config = new ConfigurationBuilder().AddInMemoryCollection(values).Build();
+            var services = new ServiceCollection();
