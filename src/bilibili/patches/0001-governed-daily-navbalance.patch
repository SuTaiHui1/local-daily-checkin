+
+    [Theory]
+    [InlineData("{\"code\":0,\"data\":{}}", true)]
+    [InlineData("{\"code\":0,\"data\":{\"total\":0}}", false)]
+    public async Task DeserializedFollowingTotal_MissingStopsBeforeFallback_ConfirmedZeroAllowsRanking(string json, bool missing)
