+++ b/src/Ray.BiliBiliTool.Agent/FixedVideoDiagnosticScope.cs
@@ -0,0 +1,35 @@
+namespace Ray.BiliBiliTool.Agent;
+
+public sealed class FixedVideoDiagnosticScope : IDisposable
+{
+    public const long TargetAid = 262519866;
+    private sealed record State(DateTimeOffset Deadline, DateOnly Date, TimeProvider Clock);
+    private static readonly AsyncLocal<State?> Current = new();
+    private readonly State? _previous;
+
+    private FixedVideoDiagnosticScope(DateTimeOffset deadline, TimeProvider clock)
+    {
+        _previous = Current.Value;
+        var now = clock.GetUtcNow();
+        if (deadline <= now || deadline > now.AddMinutes(15))
+            throw new InvalidOperationException("CONTROLLED_BLOCKED Invalid execution deadline.");
+        Current.Value = new State(deadline, LocalDate(now), clock);
+    }
+
+    public static FixedVideoDiagnosticScope Begin(DateTimeOffset deadline, TimeProvider? clock = null)
+        => new(deadline, clock ?? TimeProvider.System);
+
+    public static void EnsureAllowed()
+    {
+        var state = Current.Value;
+        if (state is null) return;
+        var now = state.Clock.GetUtcNow();
+        if (now >= state.Deadline || LocalDate(now) != state.Date)
+            throw new InvalidOperationException("CONTROLLED_BLOCKED Execution expired or crossed the local day; no further requests.");
+    }
+
+    private static DateOnly LocalDate(DateTimeOffset value)
+        => DateOnly.FromDateTime(value.ToOffset(TimeSpan.FromHours(8)).DateTime);
+
+    public void Dispose() => Current.Value = _previous;
+}
