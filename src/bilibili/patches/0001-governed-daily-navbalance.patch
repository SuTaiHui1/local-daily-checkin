+    [InlineData("UpVideoPage", "business", "BusinessRejected", "Unknown", "-403")]
+    [InlineData("UpVideoPage", "transport", "Transport", "Unknown", "Unknown")]
+    [InlineData("UpVideoPage", "json", "InvalidResponse", "Unknown", "Unknown")]
+    [InlineData("UpVideoPage", "empty", "EmptyData", "Unknown", "0")]
