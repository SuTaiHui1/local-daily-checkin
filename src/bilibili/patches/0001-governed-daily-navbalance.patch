+
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public async Task RealDomainAndRegisteredTransport_PreserveExplicitCookieThroughFullSequence(bool watched)
+    {
+        await using var fixture = new Fixture();
+        await fixture.Run(watched);
+        var requests = fixture.Server.Requests.ToArray();
+        Assert.Equal(watched
+            ? new[] { Following, Ranking, Heartbeat, Share }
+            : new[] { Following, Ranking, Heartbeat, Heartbeat, Share }, requests.Select(x => x.Path));
+        var mutations = requests.Where(x => x.Path == Heartbeat || x.Path == Share).ToArray();
+        Assert.All(mutations, request =>
+        {
+            Assert.Equal("POST", request.Method);
+            Assert.Contains("buvid3=SIMULATED_LOCAL", request.Cookie);
+            Assert.DoesNotContain("SIMULATED_SERVER", request.Cookie);
+            Assert.Equal(1, request.Cookie.Split(';').Count(x => x.Trim().StartsWith("buvid3=")));
+            var body = HttpUtility.ParseQueryString(request.Body);
+            Assert.Equal("123456", body["aid"]);
+            Assert.Equal("SIMULATED_CSRF", body["csrf"]);
+            Assert.Null(body["wts"]);
+        });
+        Assert.Equal("0", HttpUtility.ParseQueryString(mutations[0].Body)["played_time"]);
+        if (!watched)
+            Assert.InRange(int.Parse(HttpUtility.ParseQueryString(mutations[1].Body)["played_time"]!), 1, 14);
+        Assert.Equal("web_normal", HttpUtility.ParseQueryString(mutations[^1].Body)["source"]);
+        Assert.Equal(1, requests.Count(x => x.Path == Share));
+        Assert.Equal(requests.Length, fixture.Route.Attempts);
+    }
+
+    [Theory]
+    [InlineData(false, "open", "403")]
+    [InlineData(false, "open", "empty")]
+    [InlineData(false, "open", "transport")]
+    [InlineData(false, "final", "403")]
+    [InlineData(false, "final", "empty")]
+    [InlineData(false, "final", "transport")]
+    [InlineData(false, "share", "403")]
+    [InlineData(false, "share", "empty")]
+    [InlineData(false, "share", "transport")]
+    [InlineData(true, "share", "403")]
+    [InlineData(true, "share", "empty")]
+    [InlineData(true, "share", "transport")]
+    public async Task RejectedOrUnconfirmedStage_StopsOnceWithoutFallback(bool watched, string stage, string failure)
+    {
+        await using var fixture = new Fixture(stage, failure);
+        var error = await Assert.ThrowsAnyAsync<BiliBusinessException>(() => fixture.Run(watched));
+        Assert.Contains("STOP_MUTATION_UNCONFIRMED", error.Message);
+        Assert.DoesNotContain("PRIVATE_SENTINEL", error.ToString());
+        var requests = fixture.Server.Requests.ToArray();
+        var expected = stage switch
+        {
+            "open" => new[] { Following, Ranking, Heartbeat },
+            "final" => new[] { Following, Ranking, Heartbeat, Heartbeat },
+            _ when watched => new[] { Following, Ranking, Heartbeat, Share },
+            _ => new[] { Following, Ranking, Heartbeat, Heartbeat, Share },
+        };
+        Assert.Equal(expected, requests.Select(x => x.Path));
+        Assert.Equal(stage == "share" ? 1 : 0, requests.Count(x => x.Path == Share));
+        Assert.Equal(requests.Length, fixture.Route.Attempts);
+    }
+
+    private sealed class Fixture : IAsyncDisposable
+    {
+        public LoopbackServer Server { get; }
+        public LoopbackFilter Route { get; }
+        private readonly ServiceProvider _provider;
+        private readonly VideoDomainService _service;
+
+        public Fixture(string? failedStage = null, string? failure = null, bool delayAfterOpen = false,
+            Uri? redirectAddress = null)
+        {
+            Server = new LoopbackServer(failedStage, failure, delayAfterOpen, redirectAddress);
+            Route = new LoopbackFilter(Server.Address);
+            var services = new ServiceCollection();
+            services.AddLogging();
+            services.AddOptions();
+            services.Configure<SecurityOptions>(value => value.IntervalSecondsBetweenRequestApi = 0);
+            services.Configure<DailyTaskOptions>(value => { value.IsWatchVideo = true; value.IsShareVideo = true; });
+            services.AddSingleton<IHttpMessageHandlerBuilderFilter>(Route);
+            services.AddBiliBiliClientApi(new ConfigurationBuilder().Build());
+            _provider = services.BuildServiceProvider();
+            _service = new VideoDomainService(NullLogger<VideoDomainService>.Instance,
+                _provider.GetRequiredService<IOptionsMonitor<DailyTaskOptions>>(),
+                _provider.GetRequiredService<IApiApi>());
+        }
+
+        public Task Run(bool watched) => _service.WatchAndShareVideo(
+            new DailyTaskInfo { Watch = watched, Share = false },
+            new BiliCookie(new Dictionary<string, string>
+            {
+                ["DedeUserID"] = "123", ["SESSDATA"] = "SIMULATED_SESSION",
+                ["bili_jct"] = "SIMULATED_CSRF", ["buvid3"] = "SIMULATED_LOCAL",
+            }));
+
+        public async ValueTask DisposeAsync()
+        {
+            await _provider.DisposeAsync();
+            await Server.DisposeAsync();
+        }
+    }
+
+    private sealed class LoopbackFilter(Uri address) : IHttpMessageHandlerBuilderFilter
+    {
+        public int Attempts;
+        public Action<HttpMessageHandlerBuilder> Configure(Action<HttpMessageHandlerBuilder> next) => builder =>
+        {
+            next(builder);
+            // Keep production cookie/redirect behavior. Only disable the proxy for loopback isolation.
+            if (builder.Name!.Contains(nameof(IApiApi), StringComparison.Ordinal))
+            {
+                var primary = Assert.IsType<HttpClientHandler>(builder.PrimaryHandler);
+                Assert.False(primary.UseCookies);
+                primary.UseProxy = false;
+            }
+            else
+            {
+                // Any unexpected client must fail locally without a network destination.
+                builder.PrimaryHandler = new RejectOtherClientHandler();
+            }
+            builder.AdditionalHandlers.Add(new LoopbackRouteHandler(address, this));
+        };
+    }
+
+    private sealed class RejectOtherClientHandler : HttpMessageHandler
+    {
+        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken token) =>
+            throw new InvalidOperationException("Unexpected client blocked by offline test");
+    }
+
+    private sealed class LoopbackRouteHandler(Uri address, LoopbackFilter owner) : DelegatingHandler
+    {
+        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken token)
+        {
+            Interlocked.Increment(ref owner.Attempts);
+            string path = request.RequestUri!.AbsolutePath;
+            if (path is not (Following or Ranking or Heartbeat or Share))
+                throw new InvalidOperationException("Unexpected path blocked by offline test");
+            request.RequestUri = new Uri(address, request.RequestUri.PathAndQuery);
+            request.Headers.Host = address.Authority;
+            return base.SendAsync(request, token);
+        }
+    }
+
+    private sealed record CapturedRequest(string Method, string Path, string Cookie, string Body,
+        string Referer, string Origin, string ContentType);
+
+    private sealed class LoopbackServer : IAsyncDisposable
+    {
+        private readonly TcpListener _listener = new(IPAddress.Loopback, 0);
+        private readonly CancellationTokenSource _stop = new(TimeSpan.FromSeconds(20));
+        private readonly Task _server;
+        private readonly string? _failedStage;
+        private readonly string? _failure;
+        private readonly bool _delayAfterOpen;
+        private readonly Uri? _redirectAddress;
+        private int _heartbeats;
+        public ConcurrentQueue<CapturedRequest> Requests { get; } = new();
+        public Uri Address { get; }
+
+        public LoopbackServer(string? failedStage, string? failure, bool delayAfterOpen,
+            Uri? redirectAddress = null)
+        {
+            _failedStage = failedStage;
+            _failure = failure;
+            _delayAfterOpen = delayAfterOpen;
+            _redirectAddress = redirectAddress;
+            _listener.Start();
+            Address = new Uri($"http://127.0.0.1:{((IPEndPoint)_listener.LocalEndpoint).Port}/");
+            _server = Serve();
+        }
+
+        private async Task Serve()
+        {
+            try
+            {
+                while (!_stop.IsCancellationRequested)
+                {
+                    using var connection = await _listener.AcceptTcpClientAsync(_stop.Token);
+                    await using var stream = connection.GetStream();
+                    using var reader = new StreamReader(stream, Encoding.UTF8, false, 1024, leaveOpen: true);
+                    string first = (await reader.ReadLineAsync(_stop.Token))!;
+                    string method = first.Split(' ')[0];
+                    string path = new Uri(Address, first.Split(' ')[1]).AbsolutePath;
+                    string cookie = "";
+                    string referer = "", origin = "", contentType = "";
+                    int length = 0;
+                    while (await reader.ReadLineAsync(_stop.Token) is { Length: > 0 } header)
+                    {
+                        if (header.StartsWith("Cookie:", StringComparison.OrdinalIgnoreCase))
+                            cookie += header[7..].Trim();
+                        if (header.StartsWith("Content-Length:", StringComparison.OrdinalIgnoreCase))
+                            length = int.Parse(header[15..].Trim());
+                        if (header.StartsWith("Referer:", StringComparison.OrdinalIgnoreCase))
+                            referer = header[8..].Trim();
+                        if (header.StartsWith("Origin:", StringComparison.OrdinalIgnoreCase))
+                            origin = header[7..].Trim();
+                        if (header.StartsWith("Content-Type:", StringComparison.OrdinalIgnoreCase))
+                            contentType = header[13..].Trim();
+                    }
+                    char[] body = new char[length];
+                    int read = 0;
+                    while (read < length)
+                    {
+                        int count = await reader.ReadAsync(body.AsMemory(read), _stop.Token);
+                        if (count == 0) throw new EndOfStreamException("Incomplete synthetic request");
+                        read += count;
+                    }
+                    Requests.Enqueue(new CapturedRequest(method, path, cookie, new string(body),
+                        referer, origin, contentType));
+                    string stage = path == Heartbeat ? (++_heartbeats == 1 ? "open" : "final")
+                        : path == Share ? "share" : "selection";
+                    // Force a clock-second boundary without changing production request timing.
+                    if (_delayAfterOpen && stage == "open")
+                        await Task.Delay(1500, _stop.Token);
+                    bool failing = stage == _failedStage;
+                    if (failing && _failure?.StartsWith("redirect:", StringComparison.Ordinal) == true)
+                    {
+                        string code = _failure[9..];
+                        var target = new Uri(_redirectAddress ?? Address, "redirect-followed?reason=PRIVATE_SENTINEL");
+                        byte[] redirect = Encoding.ASCII.GetBytes($"HTTP/1.1 {code} Redirect\r\nLocation: {target}\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
+                        await stream.WriteAsync(redirect, _stop.Token);
+                        continue;
+                    }
+                    if (failing && _failure == "transport")
+                        continue;
+                    string json = failing ? (_failure == "empty" ? "" : "{\"code\":-403,\"message\":\"PRIVATE_SENTINEL\"}")
+                        : path switch
+                        {
+                            Following => "{\"code\":0,\"data\":{\"total\":0,\"list\":[]}}",
+                            Ranking => "{\"code\":0,\"data\":{\"list\":[{\"aid\":123456,\"bvid\":\"BVsynthetic\",\"cid\":654321,\"title\":\"synthetic\",\"duration\":30}]}}",
+                            _ => "{\"code\":0}",
+                        };
+                    string setCookie = path == Heartbeat ? $"Set-Cookie: buvid3=SIMULATED_SERVER_{_heartbeats}; Path=/\r\n" : "";
+                    byte[] response = Encoding.UTF8.GetBytes("HTTP/1.1 200 OK\r\nContent-Type: application/json\r\n" +
+                        setCookie + $"Content-Length: {Encoding.UTF8.GetByteCount(json)}\r\nConnection: close\r\n\r\n" + json);
+                    await stream.WriteAsync(response, _stop.Token);
+                }
+            }
+            catch (OperationCanceledException) when (_stop.IsCancellationRequested) { }
+        }
+
+        public async ValueTask DisposeAsync()
+        {
+            await _stop.CancelAsync();
+            await _server;
+            _listener.Stop();
+            _stop.Dispose();
+        }
+    }
+}
