diff --git a/src/Ray.BiliBiliTool.Console/Diagnostics/ControlledCandidateGate.cs b/src/Ray.BiliBiliTool.Console/Diagnostics/ControlledCandidateGate.cs
new file mode 100644
index 0000000..54fe4e7
--- /dev/null
+++ b/src/Ray.BiliBiliTool.Console/Diagnostics/ControlledCandidateGate.cs
@@ -0,0 +1,108 @@
+using System.Globalization;
+using System.Text.Json;
+using System.Text.RegularExpressions;
+
+namespace Ray.BiliBiliTool.Console.Diagnostics;
+
+public static class ControlledCandidateGate
+{
+    public const long TargetAid = 0;
+    public sealed record Permit
+    {
+        public bool Authorized { get; init; }
+        public string? Id { get; init; }
+        public string? Date { get; init; }
+        public DateTimeOffset? NotBefore { get; init; }
+        public DateTimeOffset? ExpiresBefore { get; init; }
+        public string? CandidateSHA256 { get; init; }
+        public long TargetAid { get; init; }
+        public int MaximumNativeLaunches { get; init; }
+        public string? Scope { get; init; }
+        public int MaximumNewCoins { get; init; }
+        public int MinimumAlreadyCoins { get; init; }
+        public int DailyMaximum { get; init; }
+        public bool IncludeExperienceSummary { get; init; }
+    }
+    public sealed record Decision(string Code, DateTimeOffset? Deadline = null)
+    {
+        public bool Admitted => Code == "Ready";
+    }
+
+    public static Dictionary<string, string?> ConfigurationOverrides(DateTimeOffset deadline) => new()
+    {
+        ["RunTasks"] = "Daily",
+        ["Repair:CoinRemainderOnly"] = "true",
+        ["Repair:Scope"] = "FinalCoin",
+        ["Repair:MaximumNewCoins"] = "1",
+        ["Repair:MinimumAlreadyCoins"] = "4",
+        ["Repair:DailyMaximum"] = "5",
+        ["Repair:IncludeExperienceSummary"] = "true",
+        ["Repair:FixedVideoDiagnostic"] = "false",
+        ["Repair:ShareProbeOnly"] = "false",
+        ["Repair:CoinRemainderDeadline"] = deadline.ToString("o", CultureInfo.InvariantCulture),
+        ["DailyTaskConfig:IsEnable"] = "true",
+        ["DailyTaskConfig:IsWatchVideo"] = "false",
+        ["DailyTaskConfig:IsShareVideo"] = "false",
+        ["DailyTaskConfig:IsDonateCoinForArticle"] = "false",
+        ["DailyTaskConfig:SelectLike"] = "false",
+        ["DailyTaskConfig:NumberOfCoins"] = "5",
+        ["DailyTaskConfig:NumberOfProtectedCoins"] = "0",
+        ["DailyTaskConfig:CoinDonationStopLevel"] = "6",
+        ["DailyTaskConfig:SaveCoinsWhenLv6"] = "true",
+        ["CookieCheck:AutoCheckEnabled"] = "false",
+    };
+
+    public static Decision Decide(Permit? permit, string hash, DateTimeOffset now,
+        bool elevated, bool productionPaused, bool runtimePaused, bool attempted)
+    {
+        if (permit?.Authorized != true) return new("PermitNotAuthorized");
+        if (elevated) return new("OrdinaryUserRequired");
+        if (!productionPaused) return new("ProductionPauseMissing");
+        if (runtimePaused) return new("RuntimePaused");
+        if (permit.Scope != "FinalCoin" || permit.MaximumNewCoins != 1 || permit.MinimumAlreadyCoins != 4 || permit.DailyMaximum != 5 ||
+            !permit.IncludeExperienceSummary ||
+            permit.TargetAid != TargetAid || permit.MaximumNativeLaunches != 1 ||
+            !Regex.IsMatch(permit.Id ?? "", @"\Abili-controlled-[0-9]{8}-coins2\z") ||
+            !DateOnly.TryParseExact(permit.Date, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date) ||
+            !permit.Id!.StartsWith("bili-controlled-" + date.ToString("yyyyMMdd") + "-", StringComparison.Ordinal) ||
+            permit.NotBefore is not { } start || permit.ExpiresBefore is not { } end ||
+            end <= start || end - start > TimeSpan.FromMinutes(30) ||
+            DateOnly.FromDateTime(start.ToOffset(TimeSpan.FromHours(8)).DateTime) != date ||
+            DateOnly.FromDateTime(end.AddTicks(-1).ToOffset(TimeSpan.FromHours(8)).DateTime) != date)
+            return new("InvalidPermit");
+        if (DateOnly.FromDateTime(now.ToOffset(TimeSpan.FromHours(8)).DateTime) != date) return new("WrongDate");
+        if (now < start) return new("TooEarly");
+        if (now >= end) return new("Expired");
+        if (!Regex.IsMatch(permit.CandidateSHA256 ?? "", @"\A[0-9A-Fa-f]{64}\z") ||
+            !string.Equals(hash, permit.CandidateSHA256, StringComparison.OrdinalIgnoreCase)) return new("VersionMismatch");
+        if (attempted) return new("AlreadyAttempted");
+        return new("Ready", now.AddMinutes(15) < end ? now.AddMinutes(15) : end);
+    }
+
+    public static Decision Admit(string directory, string hash, DateTimeOffset now,
+        bool elevated, bool productionPaused, string[] args)
+    {
+        if (args.Length != 1 || args[0] != "--runTasks=Daily") return new("ModeNotAllowed");
+        Permit? permit;
+        try
+        {
+            var path = Path.Combine(directory, "controlled-permit.json");
+            if (!File.Exists(path)) return new("PermitMissing");
+            permit = JsonSerializer.Deserialize<Permit>(File.ReadAllText(path));
+        }
+        catch { return new("InvalidPermit"); }
+        var decision = Decide(permit, hash, now, elevated, productionPaused,
+            File.Exists(Path.Combine(directory, "daily-paused.txt")), false);
+        if (!decision.Admitted) return decision;
+        var attempt = Path.Combine(directory, permit!.Id + ".attempted");
+        try
+        {
+            using var stream = new FileStream(attempt, FileMode.CreateNew, FileAccess.Write, FileShare.None);
+            using var writer = new StreamWriter(stream);
+            writer.Write(now.ToString("o", CultureInfo.InvariantCulture));
+        }
+        catch (IOException) { return new("AlreadyAttemptedOrStorageUnavailable"); }
+        catch { return new("AttemptStorageUnavailable"); }
+        return decision;
+    }
+}
