+using System.Net;
+using System.Net.Http.Headers;
+using System.Text;
+using System.Text.Json;
+using Microsoft.Extensions.Logging;
+using Ray.BiliBiliTool.Agent.HttpClientDelegatingHandlers;
+using Ray.BiliBiliTool.CharacterizationTests.Support;
+
+namespace Ray.BiliBiliTool.CharacterizationTests;
+
+public sealed class ShareFailureReasonTests
+{
+    [Theory]
+    [InlineData("账号异常，操作失败", "AccountAbnormal")]
+    [InlineData("视频不存在", "VideoUnavailable")]
+    [InlineData("视频不可用", "VideoUnavailable")]
+    [InlineData("账号未登录", "NotLoggedIn")]
+    [InlineData("CSRF 校验失败", "CsrfRejected")]
+    [InlineData("请求过于频繁", "TooFrequent")]
+    [InlineData("验证码验证失败", "VerificationRequired")]
+    [InlineData("请求被拦截", "RequestRejected")]
+    [InlineData("权限不足", "PermissionDenied")]
+    [InlineData("PRIVATE_UNKNOWN_MESSAGE", "OtherReasonWithheld")]
+    [InlineData("", "NotProvided")]
+    public async Task FailureReasonIsFixedCategory_InSameReplyLine_AndPreservesResponse(string message, string reason)
+    {
+        string body = JsonSerializer.Serialize(new { code = -403, message, data = "PRIVATE_BODY_SENTINEL" });
+        using var fixture = new Fixture(new StringContent(body, Encoding.UTF8, "application/json"));
+        var originalContent = fixture.Response.Content;
+        using var response = await fixture.Send();
+        Assert.Same(fixture.Response, response);
+        Assert.Same(originalContent, response.Content);
+        Assert.Equal(body, await response.Content.ReadAsStringAsync());
+        Assert.Equal("application/json", response.Content.Headers.ContentType!.MediaType);
+        Assert.Equal(1, fixture.Terminal.Calls);
+        var line = Assert.Single(fixture.Log.Entries.Where(x => x.Message.Contains("SHARE_CONTEXT Reply"))).Message;
+        Assert.Contains("ServerCode=-403", line);
+        Assert.Contains("FailureReason=" + reason, line);
+        Assert.All(fixture.Log.Entries, item => Assert.DoesNotContain("PRIVATE_", item.Message));
+    }
+
+    [Theory]
+    [InlineData("{PRIVATE_MALFORMED", "BodyUnconfirmed")]
+    [InlineData("[]", "BodyUnconfirmed")]
+    [InlineData("{\"code\":0,\"message\":\"PRIVATE_MESSAGE\"}", "ReplyCodeMismatch")]
+    [InlineData("{\"code\":-403,\"message\":123}", "NotProvided")]
+    [InlineData("{\"code\":-403}", "NotProvided")]
+    public async Task MalformedOrAmbiguousReply_IsConservative_AndRemainsReadable(string body, string reason)
+    {
+        using var fixture = new Fixture(new StringContent(body, Encoding.UTF8, "application/json"));
+        using var response = await fixture.Send();
+        Assert.Equal(body, await response.Content.ReadAsStringAsync());
+        Assert.Contains(fixture.Log.Entries, item => item.Message.Contains("FailureReason=" + reason));
+        Assert.Equal(1, fixture.Terminal.Calls);
+        Assert.All(fixture.Log.Entries, item => Assert.DoesNotContain("PRIVATE_", item.Message));
+    }
+
+    [Theory]
+    [InlineData(null, "application/json", "BodyLengthUnknown")]
+    [InlineData(16385L, "application/json", "BodyTooLarge")]
+    [InlineData(30L, "text/html", "BodyNotJson")]
+    public async Task UnboundedLargeOrNonJsonBody_IsNotRead(long? length, string mediaType, string reason)
+    {
+        var content = new ForbiddenReadContent();
+        content.Headers.ContentLength = length;
+        content.Headers.ContentType = new MediaTypeHeaderValue(mediaType);
+        using var fixture = new Fixture(content);
+        using var response = await fixture.Send();
+        Assert.Same(content, response.Content);
+        Assert.Equal(0, content.ReadAttempts);
+        Assert.Contains(fixture.Log.Entries, item => item.Message.Contains("FailureReason=" + reason));
+        Assert.Equal(1, fixture.Terminal.Calls);
+    }
+
+    [Theory]
+    [InlineData("/x/web-interface/share/add", "0")]
+    [InlineData("/x/web-interface/share/add", null)]
+    [InlineData("/x/click-interface/web/heartbeat", "-403")]
+    public async Task SuccessfulMissingCodeOrHeartbeatResponse_DoesNotReadBody(string path, string? code)
+    {
+        var content = new ForbiddenReadContent();
+        content.Headers.ContentLength = 30;
+        using var fixture = new Fixture(content, code);
+        using var response = await fixture.Send(path);
+        Assert.Equal(0, content.ReadAttempts);
+        Assert.Contains(fixture.Log.Entries, item => item.Message.Contains("FailureReason=NotObserved"));
+        Assert.Equal(1, fixture.Terminal.Calls);
+    }
+
+    [Theory]
+    [InlineData(true, "BodyReadTimedOut")]
+    [InlineData(false, "BodyUnconfirmed")]
+    public async Task SlowOrBrokenErrorBody_StillEmitsStopCode_WithoutLeaking(bool slow, string reason)
+    {
+        using var fixture = new Fixture(new FaultyContent(slow));
+        var started = System.Diagnostics.Stopwatch.StartNew();
+        using var response = await fixture.Send();
+        Assert.True(started.Elapsed < TimeSpan.FromSeconds(5));
+        Assert.Equal(1, fixture.Terminal.Calls);
+        var line = Assert.Single(fixture.Log.Entries.Where(x => x.Message.Contains("SHARE_CONTEXT Reply"))).Message;
+        Assert.Contains("ServerCode=-403", line);
+        Assert.Contains("FailureReason=" + reason, line);
+        Assert.All(fixture.Log.Entries, item => Assert.DoesNotContain("PRIVATE_", item.Message));
+    }
+
+    private sealed class Fixture : IDisposable
+    {
+        public readonly TestLogCollector Log = new();
+        private readonly ILoggerFactory _logging;
+        private readonly HttpMessageInvoker _client;
+        public readonly Terminal Terminal;
+        public readonly HttpResponseMessage Response;
+
+        public Fixture(HttpContent content, string? code = "-403")
+        {
+            Response = new(HttpStatusCode.OK) { Content = content };
+            if (code is not null) Response.Headers.Add("Bili-Status-Code", code);
+            _logging = LoggerFactory.Create(builder => builder.AddProvider(Log));
+            Terminal = new Terminal(Response);
+            _client = new HttpMessageInvoker(new ShareContextDiagnosticDelegatingHandler(
+                _logging.CreateLogger<ShareContextDiagnosticDelegatingHandler>()) { InnerHandler = Terminal });
+        }
+
+        public Task<HttpResponseMessage> Send(string path = "/x/web-interface/share/add") =>
+            _client.SendAsync(new HttpRequestMessage(HttpMethod.Post, "https://offline.invalid" + path)
+            {
+                Content = new FormUrlEncodedContent(new Dictionary<string, string> { ["aid"] = "1" }),
+            }, CancellationToken.None);
+
+        public void Dispose() { _client.Dispose(); _logging.Dispose(); }
+    }
+
+    private sealed class Terminal(HttpResponseMessage response) : HttpMessageHandler
+    {
+        public int Calls;
+        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken token)
+        {
+            Calls++;
+            return Task.FromResult(response);
+        }
+    }
+
+    private sealed class ForbiddenReadContent : HttpContent
+    {
+        public int ReadAttempts;
+        protected override Task SerializeToStreamAsync(Stream stream, TransportContext? context)
+        {
+            ReadAttempts++;
+            throw new InvalidOperationException("PRIVATE_BODY_MUST_NOT_BE_READ");
+        }
+        protected override bool TryComputeLength(out long length) { length = 0; return false; }
+    }
+
+    private sealed class FaultyContent(bool slow) : HttpContent
+    {
+        protected override Task SerializeToStreamAsync(Stream stream, TransportContext? context) =>
+            SerializeToStreamAsync(stream, context, CancellationToken.None);
+        protected override async Task SerializeToStreamAsync(Stream stream, TransportContext? context, CancellationToken token)
+        {
+            if (slow) await Task.Delay(Timeout.Infinite, token);
+            else
+            {
+                await stream.WriteAsync(Encoding.UTF8.GetBytes("PRIVATE_PARTIAL"), token);
+                throw new IOException("PRIVATE_STREAM_ERROR");
+            }
+        }
+        protected override bool TryComputeLength(out long length) { length = 64; return true; }
+    }
+}
