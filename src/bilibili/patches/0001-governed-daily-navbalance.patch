+        public int PriorFloor; public bool ReadOnly; public string? LedgerDirectory; public string? RunNonce;
+        public int JournalSequence; public string? PendingIntent; public int AccountingBefore;
+    }
+    private static readonly AsyncLocal<State?> Current = new();
+    private readonly State? _previous;
+    private GovernedDailyScope(int priorFloor, bool readOnly, string? ledgerDirectory, string? runNonce) {
+        if (priorFloor is < 0 or > 5) throw new InvalidOperationException("DAILY_BLOCKED InvalidRecoveryFloor");
+        _previous = Current.Value;
+        Current.Value = new() { PriorFloor = priorFloor, ReadOnly = readOnly, LedgerDirectory = ledgerDirectory, RunNonce = runNonce };
+    }
+    public static bool IsActive => Current.Value is not null;
+    public static int CurrentLevel => Current.Value?.Level ?? -1;
+    public static int NativeSuccessCoins => Current.Value?.Success ?? 0;
+    public static int PriorCoinFloor => Current.Value?.PriorFloor ?? 0;
+    public static bool ReadOnly => Current.Value?.ReadOnly ?? false;
+    public static decimal? LoginCoinBalance => Current.Value?.LoginCoinBalance;
+    public static GovernedDailyScope Begin(int priorFloor = 0, bool readOnly = false, string? ledgerDirectory = null, string? runNonce = null)
+        => new(priorFloor, readOnly, ledgerDirectory, runNonce);
+    public static void SetLevel(int level) { if (Current.Value is { } state) state.Level = level; }
+    public static void SetLoginCoinBalance(decimal? balance) { if (Current.Value is { } state) state.LoginCoinBalance = balance; }
+    public static void ConfirmCoin() { if (Current.Value is { } state) state.Success++; }
+    public static void SetCoinAccounting(int value) { if (Current.Value is { } state) state.AccountingBefore = value; }
+    public static void PersistCoinIntent(long aid)
+    {
+        var state = Current.Value ?? throw new InvalidOperationException("DAILY_BLOCKED MissingCoinScope");
+        if (state.ReadOnly || string.IsNullOrWhiteSpace(state.LedgerDirectory) ||
+            !Guid.TryParseExact(state.RunNonce, "N", out _) || state.AccountingBefore is < 0 or >= 5 || state.PendingIntent is not null)
+            throw new InvalidOperationException("DAILY_BLOCKED CoinJournalUnavailable");
+        int sequence = ++state.JournalSequence;
+        if (sequence > 5) throw new InvalidOperationException("DAILY_BLOCKED CoinPostLimit");
+        string date = DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(8)).ToString("yyyy-MM-dd");
+        string path = Path.Combine(state.LedgerDirectory, $"CoinPost-{date.Replace("-", "")}-{state.RunNonce}-{sequence}.json");
+        WriteImmutable(path, new { Date = date, state.RunNonce, Sequence = sequence, Aid = aid,
+            AccountingBefore = state.AccountingBefore, Coins = 1, ClaimedAt = DateTimeOffset.UtcNow.ToString("o"), Status = "ClaimedBeforeSubmit" });
+        state.PendingIntent = path;
+    }
+    public static void PersistCoinConfirmation()
+    {
+        var state = Current.Value ?? throw new InvalidOperationException("DAILY_BLOCKED MissingCoinScope");
+        string path = state.PendingIntent ?? throw new InvalidOperationException("DAILY_BLOCKED CoinIntentMissing");
+        string date = DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(8)).ToString("yyyy-MM-dd");
+        WriteImmutable(Path.ChangeExtension(path, ".result.json"), new { Date = date, state.RunNonce,
+            Sequence = state.JournalSequence, Status = "Confirmed", BusinessCode = 0, Coins = 1,
+            AccountingAfter = state.AccountingBefore + 1, ObservedAt = DateTimeOffset.UtcNow.ToString("o"),
+            IntentSHA256 = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(File.ReadAllBytes(path))) });
+        state.PendingIntent = null;
+    }
+    public static void PersistCoinRejection(int code)
+    {
+        // Only explicit API rejections release a reservation; unknown responses stay pending.
+        if (code is not (-101 or -102 or -111 or -400 or -403 or -412 or 10003 or 34002 or 34003 or 34004 or 34005)) return;
+        var state = Current.Value ?? throw new InvalidOperationException("DAILY_BLOCKED MissingCoinScope");
+        string path = state.PendingIntent ?? throw new InvalidOperationException("DAILY_BLOCKED CoinIntentMissing");
+        WriteImmutable(Path.ChangeExtension(path, ".result.json"), new {
+            Date = DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(8)).ToString("yyyy-MM-dd"), state.RunNonce,
+            Sequence = state.JournalSequence, Status = "Rejected", BusinessCode = code, Coins = 1,
+            AccountingAfter = state.AccountingBefore, ObservedAt = DateTimeOffset.UtcNow.ToString("o"),
+            IntentSHA256 = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(File.ReadAllBytes(path))) });
+        state.PendingIntent = null;
+    }
+    private static void WriteImmutable(string path, object value)
+    {
+        byte[] data = System.Text.Json.JsonSerializer.SerializeToUtf8Bytes(value);
+        using var stream = new FileStream(path, FileMode.CreateNew, FileAccess.Write, FileShare.Read);
+        stream.Write(data);
+        stream.Flush(true);
+    }
+    public static async Task EnsureRequestAllowed(HttpRequestMessage request, CancellationToken token)
+    {
+        var state = Current.Value;
+        if (state is null) return;
+        var path = request.RequestUri?.AbsolutePath;
+        if (state.ReadOnly && request.Method != HttpMethod.Get)
+            throw new InvalidOperationException("DAILY_BLOCKED ReadOnlyRecoveryMutationForbidden");
+        if (request.Method == HttpMethod.Get && path is
+            "/x/web-interface/nav" or "/site/getCoin" or "/x/web-interface/coin/today/exp" or "/x/member/web/exp/reward" or
+            "/x/relation/tag" or "/x/relation/followings" or "/x/space/wbi/arc/search" or
+            "/x/web-interface/ranking/v2" or "/x/web-interface/archive/coins" or "/x/web-interface/view") return;
+        if (request.Method == HttpMethod.Post && path is "/x/click-interface/web/heartbeat" or "/x/web-interface/share/add") return;
+        if (request.Method != HttpMethod.Post || path != "/x/web-interface/coin/add" || request.Content is null)
+            throw new InvalidOperationException("DAILY_FLOW Stopped Stage=Transport Reason=EndpointForbidden");
+        var form = System.Web.HttpUtility.ParseQueryString(await request.Content.ReadAsStringAsync(token));
+        if (form.GetValues("multiply") is not { Length: 1 } || form["multiply"] != "1" ||
+            form.GetValues("select_like") is not { Length: 1 } || form["select_like"] != "0")
+            throw new InvalidOperationException("DAILY_COINS Stopped Stage=Submit Reason=CoinFormForbidden");
+        if (Interlocked.Increment(ref state.CoinPosts) > 5)
+            throw new InvalidOperationException("DAILY_COINS Stopped Stage=Submit Reason=PostLimitReached");
+    }
+    public void Dispose() => Current.Value = _previous;
+}
