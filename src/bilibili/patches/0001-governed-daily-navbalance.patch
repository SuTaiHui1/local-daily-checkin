@@ -0,0 +1,33 @@
+namespace Ray.BiliBiliTool.Agent;
+
+public sealed class CoinRemainderScope : IDisposable
+{
+    public const int MaximumNewCoins = 1;
+    public const int MinimumAlreadyCoins = 4;
+    public const int DailyMaximum = 5;
+    private sealed class State { public int Posts; }
+    private static readonly AsyncLocal<State?> Active = new();
+    private readonly State? _previous;
+    private CoinRemainderScope() { _previous = Active.Value; Active.Value = new(); }
+    public static bool IsActive => Active.Value is not null;
+    public static CoinRemainderScope Begin() => new();
+    public static async Task EnsureRequestAllowed(HttpRequestMessage request, CancellationToken token)
+    {
+        var state = Active.Value;
+        if (state is null) return;
+        var path = request.RequestUri?.AbsolutePath;
+        if (request.Method == HttpMethod.Get && path is
+            "/x/web-interface/nav" or "/site/getCoin" or "/x/web-interface/coin/today/exp" or
+            "/x/relation/tag" or "/x/relation/followings" or "/x/space/wbi/arc/search" or
+            "/x/web-interface/ranking/v2" or "/x/web-interface/archive/coins" or "/x/web-interface/view") return;
+        if (request.Method != HttpMethod.Post || path != "/x/web-interface/coin/add" || request.Content is null)
+            throw new InvalidOperationException("COIN_REMAINDER Stopped Reason=EndpointForbidden");
+        var form = System.Web.HttpUtility.ParseQueryString(await request.Content.ReadAsStringAsync(token));
+        if (form.GetValues("multiply") is not { Length: 1 } || form["multiply"] != "1" ||
+            form.GetValues("select_like") is not { Length: 1 } || form["select_like"] != "0")
+            throw new InvalidOperationException("COIN_REMAINDER Stopped Reason=CoinFormForbidden");
+        if (Interlocked.Increment(ref state.Posts) > MaximumNewCoins)
+            throw new InvalidOperationException("COIN_REMAINDER Stopped Reason=PostLimitReached");
+    }
+    public void Dispose() => Active.Value = _previous;
+}
