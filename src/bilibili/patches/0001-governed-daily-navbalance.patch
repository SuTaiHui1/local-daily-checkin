+        private object Forbidden() { ForbiddenCalls++; throw new InvalidOperationException("PRIVATE_SENTINEL"); }
+        private Task<BiliApiResponse<int?>> Total()
+        {
+            CountReads++;
+            if (CountReads == ManualAtRead) ActualDaily = PlatformDaily = ManualTotal;
+            int value = CountReads == RegressAtRead ? 0 : PlatformDaily;
+            return Task.FromResult(new BiliApiResponse<int?> { Code = 0, Data = CountReads == UnknownCountAt ? null : value * 10 });
+        }
+        public void Dispose() {
+            Environment.SetEnvironmentVariable("BILI_DAILY_RUN_NONCE", _previousNonce);
+            foreach (var item in _previousRecovery) Environment.SetEnvironmentVariable(item.Key, item.Value);
+            _logging.Dispose();
+        }
+    }
+    private sealed class Terminal : HttpMessageHandler
+    {
+        public int Calls;
+        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken token)
+        { Calls++; return Task.FromResult(new HttpResponseMessage(HttpStatusCode.OK)); }
+    }
+    private sealed class Monitor<T>(T options) : IOptionsMonitor<T>
+    { public T CurrentValue => options; public T Get(string? name) => options; public IDisposable? OnChange(Action<T, string?> listener) => null; }
+    public class Proxy : DispatchProxy
+    {
+        public Func<MethodInfo, object?[]?, object?> Handler = null!;
+        protected override object? Invoke(MethodInfo? method, object?[]? args) => Handler(method!, args);
+    }
+    private static T Stub<T>(Func<MethodInfo, object?[]?, object?> handler) where T : class
+    { var proxy = DispatchProxy.Create<T, Proxy>(); ((Proxy)(object)proxy).Handler = handler; return proxy; }
+}
