+    [Theory]
+    [InlineData("business", "BusinessRejected", "-403")]
+    [InlineData("missing-code", "MissingCode", "Unknown")]
+    [InlineData("missing-data", "MissingData", "0")]
+    public async Task UpCountFailure_BlocksBeforeAnyPageOrDonation(string failure, string kind, string code)
+    {
+        using var f = new Fixture("UpVideoCount", failure);
+        var error = await Assert.ThrowsAnyAsync<Exception>(() => f.Service.AddCoinsForVideos(f.Cookie));
+        Assert.Contains("Stage=UpVideoCount", error.Message);
