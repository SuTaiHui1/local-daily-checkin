+[Collection("Characterization")]
+public sealed class CoinCandidateFailureTests
+{
+    [Theory]
+    [InlineData("RankingList", "business", "BusinessRejected", "Unknown", "-403")]
+    [InlineData("RankingList", "http", "HttpRejected", "412", "Unknown")]
