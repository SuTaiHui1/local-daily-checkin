@@ -0,0 +1,72 @@
+using System.Net;
+using Ray.BiliBiliTool.Agent.HttpClientDelegatingHandlers;
+using Ray.BiliBiliTool.CharacterizationTests.Support;
+using Microsoft.Extensions.Logging;
+
+namespace Ray.BiliBiliTool.CharacterizationTests;
+
+public sealed class ControlledLogTests
+{
+    [Fact]
+    public async Task ObservesAllowlistedNumbersAndContextChange_WithoutEmittingValuesOrMutatingRequest()
+    {
+        var log = new TestLogCollector();
+        using var logging = LoggerFactory.Create(b => b.AddProvider(log));
+        var terminal = new Terminal();
+        using var client = new HttpClient(new ShareContextDiagnosticDelegatingHandler(
+            logging.CreateLogger<ShareContextDiagnosticDelegatingHandler>()) { InnerHandler = terminal });
+        foreach (string device in new[] { "PRIVATE_DEVICE_ONE", "PRIVATE_DEVICE_TWO" })
+        {
+            using var request = new HttpRequestMessage(HttpMethod.Post, "https://offline.invalid/x/web-interface/share/add");
+            request.Headers.Add("Cookie", $"SESSDATA=PRIVATE_SESSION; bili_jct=PRIVATE_CSRF; buvid3={device}; _uuid=PRIVATE_MARKER");
+            request.Headers.Referrer = new Uri("https://www.bilibili.com/video/av262519866/");
+            request.Content = new FormUrlEncodedContent(new Dictionary<string, string>
+            { ["aid"] = "262519866", ["csrf"] = "PRIVATE_CSRF", ["eab_x"] = "1", ["ramval"] = "7", ["source"] = "web_normal", ["ga"] = "1" });
+            await client.SendAsync(request);
+        }
+        Assert.Equal(2, terminal.Calls);
+        Assert.Contains(log.Entries, e => e.Message.Contains("AuthContextStable=True"));
+        Assert.Contains(log.Entries, e => e.Message.Contains("AuthContextStable=False"));
+        Assert.All(log.Entries, e => Assert.DoesNotContain("PRIVATE_", e.Message));
+        Assert.Contains(log.Entries, e => e.Message.Contains("Eab=1 Ram=7 SourceKind=WebNormal Ga=1"));
+        Assert.All(terminal.Bodies, b => Assert.Contains("csrf=PRIVATE_CSRF", b));
+    }
+    [Fact]
+    public async Task ContextStability_StatesItsLimitedScopeWhenAnUnobservedCookieChanges()
+    {
+        var log = new TestLogCollector();
+        using var logging = LoggerFactory.Create(b => b.AddProvider(log));
+        using var client = new HttpClient(new ShareContextDiagnosticDelegatingHandler(
+            logging.CreateLogger<ShareContextDiagnosticDelegatingHandler>()) { InnerHandler = new Terminal() });
+        foreach (string other in new[] { "PRIVATE_OTHER_ONE", "PRIVATE_OTHER_TWO" })
+        {
+            using var request = new HttpRequestMessage(HttpMethod.Post, "https://offline.invalid/x/web-interface/share/add");
+            request.Headers.Add("Cookie", "SESSDATA=PRIVATE_SESSION; bili_jct=PRIVATE_CSRF; buvid3=PRIVATE_DEVICE; _uuid=PRIVATE_MARKER; buvid4=" + other);
+            request.Content = new FormUrlEncodedContent(new Dictionary<string, string>
+                { ["aid"] = "262519866", ["csrf"] = "PRIVATE_CSRF" });
+            await client.SendAsync(request);
+        }
+        var prepared = log.Entries.Where(e => e.Message.Contains("SHARE_CONTEXT Prepared")).ToArray();
+        Assert.Equal(2, prepared.Length);
+        Assert.All(prepared, e =>
+        {
+            Assert.Contains("AuthContextStable=True", e.Message);
+            Assert.Contains("AuthContextScope=FourKnownFields", e.Message);
+            Assert.Contains("AuthContextBaseline=HandlerLifetime", e.Message);
+            Assert.DoesNotContain("PRIVATE_", e.Message);
+            // Same sensitive-line filter as the deployed Run.ps1; safe evidence must survive it.
+            Assert.DoesNotMatch(@"(?i)https?://|SESSDATA|bili_jct|DedeUserID|refresh_token|access_token|qrcode_key|变量值|^[ █▄▀?]+$|Cookie|Token|响应体|请求体|Headers|Set-Cookie", e.Message);
+        });
+    }
+
+    private sealed class Terminal : HttpMessageHandler
+    {
+        public int Calls;
+        public List<string> Bodies { get; } = [];
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken token)
+        {
+            Calls++; Bodies.Add(await request.Content!.ReadAsStringAsync(token));
+            return new HttpResponseMessage(HttpStatusCode.OK) { Content = new StringContent("unused") };
+        }
+    }
+}
