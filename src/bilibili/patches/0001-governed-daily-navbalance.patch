+            services.AddOptions();
+            services.Configure<SecurityOptions>(o => o.IntervalSecondsBetweenRequestApi = 0);
+            services.Configure<DailyTaskOptions>(o =>
+            {
+                o.IsEnable = true; o.IsWatchVideo = true; o.IsShareVideo = true;
