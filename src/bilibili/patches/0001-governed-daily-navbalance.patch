+using System.Text.Json;
+using Microsoft.Extensions.Configuration;
+using Ray.BiliBiliTool.Agent;
+using Ray.BiliBiliTool.Agent.HttpClientDelegatingHandlers;
+using Ray.BiliBiliTool.Console.Diagnostics;
+
+namespace Ray.BiliBiliTool.CharacterizationTests;
+
+public sealed class GateAndScopeTests
+{
+    private const string Hash = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA";
+    private static readonly DateTimeOffset Now = DateTimeOffset.Parse("2080-01-01T12:01:00+08:00");
+    private static ControlledCandidateGate.Permit Valid() => new()
+    {
+        Authorized = true, Id = "bili-controlled-20800101-coins2", Date = "2080-01-01",
+        NotBefore = Now.AddMinutes(-1), ExpiresBefore = Now.AddMinutes(29),
+        CandidateSHA256 = Hash, TargetAid = 0, MaximumNativeLaunches = 1,
+        Scope = "FinalCoin", MaximumNewCoins = 1, MinimumAlreadyCoins = 4, DailyMaximum = 5,
+        IncludeExperienceSummary = true,
+    };
+
+    [Fact]
+    public void FinalConfiguration_CannotRedirectAnAdmittedCandidateToAnotherTaskOrProbe()
+    {
+        var config = new ConfigurationBuilder().AddInMemoryCollection(new Dictionary<string, string?>
+        { ["RunTasks"] = "Login&VipBigPoint", ["Repair:FixedVideoDiagnostic"] = "false", ["Repair:ShareProbeOnly"] = "true" })
+            .AddInMemoryCollection(ControlledCandidateGate.ConfigurationOverrides(Now.AddMinutes(5))).Build();
+        Assert.Equal("Daily", config["RunTasks"]);
+        Assert.False(config.GetValue<bool>("Repair:FixedVideoDiagnostic"));
+        Assert.False(config.GetValue<bool>("Repair:ShareProbeOnly"));
+        Assert.True(config.GetValue<bool>("Repair:CoinRemainderOnly"));
+        Assert.Equal("FinalCoin", config["Repair:Scope"]);
+        Assert.False(config.GetValue<bool>("DailyTaskConfig:IsWatchVideo"));
+        Assert.False(config.GetValue<bool>("DailyTaskConfig:IsShareVideo"));
+        Assert.Equal(1, config.GetValue<int>("Repair:MaximumNewCoins"));
+        Assert.Equal(4, config.GetValue<int>("Repair:MinimumAlreadyCoins"));
+        Assert.True(config.GetValue<bool>("Repair:IncludeExperienceSummary"));
+    }
+
+    [Theory]
+    [InlineData("unauthorized", "PermitNotAuthorized")]
+    [InlineData("elevated", "OrdinaryUserRequired")]
+    [InlineData("production-unpaused", "ProductionPauseMissing")]
+    [InlineData("runtime-paused", "RuntimePaused")]
+    [InlineData("target", "InvalidPermit")]
+    [InlineData("scope", "InvalidPermit")]
+    [InlineData("max-new", "InvalidPermit")]
+    [InlineData("min-old", "InvalidPermit")]
+    [InlineData("daily-max", "InvalidPermit")]
+    [InlineData("summary", "InvalidPermit")]
+    [InlineData("old-remainder", "InvalidPermit")]
+    [InlineData("quota", "InvalidPermit")]
+    [InlineData("old-id", "InvalidPermit")]
+    [InlineData("id-date", "InvalidPermit")]
+    [InlineData("date-format", "InvalidPermit")]
+    [InlineData("long-window", "InvalidPermit")]
+    [InlineData("missing-window", "InvalidPermit")]
+    [InlineData("cross-day-window", "InvalidPermit")]
+    [InlineData("early", "TooEarly")]
+    [InlineData("expired", "Expired")]
+    [InlineData("wrong-day", "WrongDate")]
+    [InlineData("hash", "VersionMismatch")]
+    [InlineData("attempted", "AlreadyAttempted")]
+    public void Admission_RejectsEachUnsupportedBoundary(string variant, string expected)
+    {
+        var p = Valid(); var now = Now;
+        switch (variant)
+        {
+            case "unauthorized": p = p with { Authorized = false }; break;
