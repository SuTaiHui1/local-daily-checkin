+        Assert.Contains("Http=" + http, error.Message);
+        Assert.Contains("BusinessCode=" + code, error.Message);
+        Assert.Contains(f.Log.Entries, x => x.Message.Contains("NativeSuccessCoins=3"));
+        Assert.Null(error.InnerException);
+        Assert.DoesNotContain("PRIVATE_SENTINEL", error.ToString());
+        Assert.DoesNotContain(f.Log.Entries, x => x.Message.Contains("PRIVATE_SENTINEL"));
+        Assert.Equal(stage == "RankingList" ? 4 : 0, f.FollowingCalls);
+        Assert.DoesNotContain(f.AddRequests, x => x.Select_like != 0);
+    }
+
+    [Fact]
+    public async Task ConfirmedZeroUpCount_RemainsNormalAndDoesNotReadPage()
+    {
+        var api = Stub<IApiApi>((method, _) => method.Name == "SearchVideosByUpId"
