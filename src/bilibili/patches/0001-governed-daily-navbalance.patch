@@ -0,0 +1,22 @@
+namespace Ray.BiliBiliTool.Agent;
+
+// Only daily-task flows opt in. Stop before transmitting when their local day changes.
+public sealed class DailyExecutionScope : IDisposable
+{
+    private sealed record State(TimeProvider Clock, DateOnly Date);
+    private static readonly AsyncLocal<State?> Current = new();
+    private readonly State? _previous;
+    private DailyExecutionScope(TimeProvider clock)
+    {
+        _previous = Current.Value;
+        Current.Value = new State(clock, DateOnly.FromDateTime(clock.GetLocalNow().DateTime));
+    }
+    public static DailyExecutionScope Begin(TimeProvider? clock = null) => new(clock ?? TimeProvider.System);
+    public static void EnsureSameDay()
+    {
+        var state = Current.Value;
+        if (state is not null && DateOnly.FromDateTime(state.Clock.GetLocalNow().DateTime) != state.Date)
+            throw new InvalidOperationException("STOP_MUTATION_UNCONFIRMED 每日任务执行期间已跨日，停止后续请求，不沿用旧日状态。");
+    }
+    public void Dispose() => Current.Value = _previous;
+}
