+            Assert.Equal(1, f.FollowingCalls);
+        }
+        else
+        {
+            Assert.Equal(CandidateQueryStage.RankingList, error.Stage);
+            Assert.Equal(4, f.CandidateCalls);
+            Assert.Equal(3, f.AddCalls);
+        }
+    }
+
+    [Theory]
+    [InlineData(412, false, "HttpRejected")]
+    [InlineData(200, true, "InvalidResponse")]
+    public async Task RefitError_PreservesNumericStatus_WithoutBodyHeadersOrInner(int status, bool json, string kind)
+    {
+        using var request = new HttpRequestMessage(HttpMethod.Get, "https://example.invalid/PRIVATE_SENTINEL");
+        using var response = new HttpResponseMessage((HttpStatusCode)status) { Content = new StringContent("PRIVATE_SENTINEL") };
+        response.Headers.Add("X-Private-Fixture", "PRIVATE_SENTINEL");
+        var source = await Refit.ApiException.Create("PRIVATE_SENTINEL", request, HttpMethod.Get, response, new Refit.RefitSettings(), json ? new JsonException("PRIVATE_SENTINEL") : null);
+        var safe = CandidateQueryFailure.From(CandidateQueryStage.RankingList, source);
+        Assert.Contains("Kind=" + kind, safe.Message);
+        Assert.Contains("Http=" + status, safe.Message);
+        Assert.Contains("BusinessCode=Unknown", safe.Message);
