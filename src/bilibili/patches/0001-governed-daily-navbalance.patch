+    private static T Blocked<T>() where T : class => Stub<T>((_, _) =>
+        throw new InvalidOperationException("Unexpected operation blocked by offline test"));
+
+    private static T Stub<T>(Func<MethodInfo, object?[]?, object?> invoke) where T : class
+    {
+        T proxy = DispatchProxy.Create<T, MethodStub>();
+        ((MethodStub)(object)proxy).Call = invoke;
+        return proxy;
+    }
+
+    public class MethodStub : DispatchProxy
+    {
+        public Func<MethodInfo, object?[]?, object?> Call = null!;
+        protected override object? Invoke(MethodInfo? targetMethod, object?[]? args) => Call(targetMethod!, args);
+    }
+
+    private sealed class MemoryOnlyFilter(MemoryWire wire) : IHttpMessageHandlerBuilderFilter
+    {
+        public Action<HttpMessageHandlerBuilder> Configure(Action<HttpMessageHandlerBuilder> next) => builder =>
+        {
+            next(builder);
+            if (builder.Name!.Contains(nameof(IApiApi), StringComparison.Ordinal))
+                Assert.False(Assert.IsType<HttpClientHandler>(builder.PrimaryHandler).UseCookies);
+            // No socket, DNS, file configuration or real response is used by this fixture.
+            builder.PrimaryHandler = wire;
+        };
+    }
+
+    private sealed record WireRequest(string Method, string Path, string Query, Version Version,
+        HttpVersionPolicy VersionPolicy, string ContentType,
+        Dictionary<string, string> Headers, Dictionary<string, string> Form);
+
+    private sealed class MemoryWire(long selectedAid, int shareCode, bool followedUp) : HttpMessageHandler
+    {
+        public List<WireRequest> Requests { get; } = [];
+        protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken token)
+        {
+            var parsed = HttpUtility.ParseQueryString(request.Content is null ? "" : await request.Content.ReadAsStringAsync(token));
+            Requests.Add(new WireRequest(request.Method.Method, request.RequestUri!.AbsolutePath,
+                request.RequestUri.Query, request.Version, request.VersionPolicy, request.Content?.Headers.ContentType?.ToString() ?? "",
+                request.Headers.ToDictionary(p => p.Key, p => string.Join(";", p.Value), StringComparer.OrdinalIgnoreCase),
+                parsed.AllKeys.ToDictionary(k => k!, k => parsed[k!]!)));
+            string body = request.RequestUri.AbsolutePath switch
+            {
+                "/x/relation/followings" => followedUp ? "{\"code\":0,\"data\":{\"total\":1,\"list\":[{\"mid\":777,\"uname\":\"Synthetic UP\"}]}}" : "{\"code\":0,\"data\":{\"total\":0,\"list\":[]}}",
+                "/x/web-interface/ranking/v2" => System.Text.Json.JsonSerializer.Serialize(new { code = 0,
+                    data = new { list = new[] { new { aid = selectedAid, bvid = "BV_SYNTHETIC", cid = 456, duration = 60, title = "Synthetic video" } } } }),
+                "/x/space/wbi/arc/search" => System.Text.Json.JsonSerializer.Serialize(new { code = 0,
+                    data = new { page = new { count = 1 }, list = new { vlist = new[] { new { aid = selectedAid, bvid = "BV_SYNTHETIC", length = "01:00", title = "Synthetic video" } } } } }),
+                "/x/web-interface/nav" => System.Text.Json.JsonSerializer.Serialize(new { code = 0,
+                    data = new { isLogin = true, wbi_img = new { img_url = "https://example.invalid/wbi/0123456789abcdef0123456789abcdef.png", sub_url = "https://example.invalid/wbi/fedcba9876543210fedcba9876543210.png" } } }),
+                Heartbeat => "{\"code\":0}",
+                Share => System.Text.Json.JsonSerializer.Serialize(new { code = shareCode, message = "synthetic refusal" }),
+                _ => throw new InvalidOperationException("Unexpected endpoint blocked by offline test"),
+            };
+            var response = new HttpResponseMessage(HttpStatusCode.OK)
+            { RequestMessage = request, Content = new StringContent(body, Encoding.UTF8, "application/json") };
+            response.Headers.Add("Set-Cookie", "buvid3=SERVER_SENTINEL; Path=/");
+            return response;
+        }
+    }
