+++ b/src/Ray.BiliBiliTool.DomainService/CandidateQueryFailure.cs
@@ -0,0 +1,58 @@
+using System.Globalization;
+using Ray.BiliBiliTool.Agent.BiliBiliAgent.Dtos;
+using Ray.BiliBiliTool.Domain.Exceptions;
+
+namespace Ray.BiliBiliTool.DomainService;
+
+public enum CandidateQueryStage
+{
+    Selection, RankingList, RankingCandidate, UpVideoCount, UpVideoPage, UpCandidate,
+    VideoDetail, SpecialFollowingList, FollowingList, DonationHistory, DonationEligibility,
+}
+
+public enum CandidateQueryFailureKind
+{
+    MissingResponse, MissingCode, BusinessRejected, MissingData, EmptyData, InvalidData,
+    HttpRejected, Transport, InvalidResponse, CanceledOrTimeout, ClientFailure,
+}
+
+// Only enums and numeric observations cross the failure boundary. Never retain raw exceptions.
+public sealed class CandidateQueryFailure : BiliBusinessException
+{
+    public CandidateQueryStage Stage { get; }
+    public CandidateQueryFailureKind Kind { get; }
+    public int? HttpStatus { get; }
+    public int? BusinessCode { get; }
+
+    public CandidateQueryFailure(CandidateQueryStage stage, CandidateQueryFailureKind kind,
+        int? httpStatus = null, int? businessCode = null)
+        : base($"STOP_MUTATION_UNCONFIRMED COIN_QUERY_FAILURE Stage={stage} Kind={kind} Http={Number(httpStatus)} BusinessCode={Number(businessCode)}")
+    {
+        Stage = stage; Kind = kind; HttpStatus = httpStatus; BusinessCode = businessCode;
+    }
+
+    private static string Number(int? value) => value?.ToString(CultureInfo.InvariantCulture) ?? "Unknown";
+
+    public static T RequireData<T>(CandidateQueryStage stage, BiliApiResponse<T>? response) where T : class
+    {
+        if (response is null) throw new CandidateQueryFailure(stage, CandidateQueryFailureKind.MissingResponse);
+        if (response.Code == int.MinValue) throw new CandidateQueryFailure(stage, CandidateQueryFailureKind.MissingCode);
+        if (response.Code != 0) throw new CandidateQueryFailure(stage, CandidateQueryFailureKind.BusinessRejected, businessCode: response.Code);
+        return response.Data ?? throw new CandidateQueryFailure(stage, CandidateQueryFailureKind.MissingData, businessCode: 0);
+    }
+
+    public static CandidateQueryFailure From(CandidateQueryStage stage, Exception error)
+    {
+        if (error is CandidateQueryFailure failure) return failure;
+        if (error is Refit.ApiException api)
+            return new(stage, IsJson(api.InnerException) ? CandidateQueryFailureKind.InvalidResponse : CandidateQueryFailureKind.HttpRejected, (int)api.StatusCode);
+        if (error is HttpRequestException request)
+            return new(stage, request.StatusCode.HasValue ? CandidateQueryFailureKind.HttpRejected : CandidateQueryFailureKind.Transport,
+                request.StatusCode.HasValue ? (int)request.StatusCode.Value : null);
+        if (IsJson(error)) return new(stage, CandidateQueryFailureKind.InvalidResponse);
+        if (error is OperationCanceledException) return new(stage, CandidateQueryFailureKind.CanceledOrTimeout);
+        return new(stage, CandidateQueryFailureKind.ClientFailure);
+    }
+
+    private static bool IsJson(Exception? error) => error is System.Text.Json.JsonException or Newtonsoft.Json.JsonException;
+}
